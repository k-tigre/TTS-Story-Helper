CREATE TABLE chapter (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    audio_path TEXT,
    markup_done INTEGER NOT NULL DEFAULT 0,
    voice_done INTEGER NOT NULL DEFAULT 0,
    exported INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE paragraph (
    chapter_id TEXT NOT NULL REFERENCES chapter(id) ON DELETE CASCADE,
    ordinal INTEGER NOT NULL,
    original_text TEXT NOT NULL DEFAULT '',
    marked_text TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (chapter_id, ordinal)
);

selectAllForList:
SELECT id, name, markup_done, voice_done, exported
FROM chapter
ORDER BY id;

selectById:
SELECT *
FROM chapter
WHERE id = ?;

insertChapter:
INSERT INTO chapter(id, name, audio_path, markup_done, voice_done, exported)
VALUES (?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM chapter
WHERE id = ?;

deleteAll:
DELETE FROM chapter;

updateName:
UPDATE chapter
SET name = ?
WHERE id = ?;

updateAudioPath:
UPDATE chapter
SET audio_path = ?
WHERE id = ?;

clearAudioPath:
UPDATE chapter
SET audio_path = NULL
WHERE id = ?;

updateMarkupDone:
UPDATE chapter
SET markup_done = ?
WHERE id = ?;

updateVoiceDone:
UPDATE chapter
SET voice_done = ?
WHERE id = ?;

updateExported:
UPDATE chapter
SET exported = ?
WHERE id = ?;

invalidateExportIfExported:
UPDATE chapter
SET exported = 0
WHERE id = ? AND exported = 1;

chapterCount:
SELECT count(*) FROM chapter;

-- Paragraphs
selectParagraphsForChapter:
SELECT ordinal, original_text, marked_text
FROM paragraph
WHERE chapter_id = ?
ORDER BY ordinal ASC;

deleteParagraphsForChapter:
DELETE FROM paragraph
WHERE chapter_id = ?;

insertParagraph:
INSERT INTO paragraph(chapter_id, ordinal, original_text, marked_text)
VALUES (?, ?, ?, ?);
