CREATE TABLE chapter (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    text TEXT NOT NULL DEFAULT '',
    original_text TEXT NOT NULL DEFAULT '',
    audio_path TEXT,
    markup_done INTEGER NOT NULL DEFAULT 0,
    voice_done INTEGER NOT NULL DEFAULT 0,
    exported INTEGER NOT NULL DEFAULT 0
);

selectAllForList:
SELECT id, name, markup_done, voice_done, exported
FROM chapter
ORDER BY id;

selectById:
SELECT *
FROM chapter
WHERE id = ?;

insertFull:
INSERT INTO chapter(id, name, text, original_text, audio_path, markup_done, voice_done, exported)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM chapter
WHERE id = ?;

deleteAll:
DELETE FROM chapter;

updateText:
UPDATE chapter
SET text = ?
WHERE id = ?;

updateOriginalText:
UPDATE chapter
SET original_text = ?
WHERE id = ?;

updateName:
UPDATE chapter
SET name = ?
WHERE id = ?;

updateAudioPath:
UPDATE chapter
SET audio_path = ?
WHERE id = ?;

clearAudioPath:
UPDATE chapter
SET audio_path = NULL
WHERE id = ?;

updateMarkupDone:
UPDATE chapter
SET markup_done = ?
WHERE id = ?;

updateVoiceDone:
UPDATE chapter
SET voice_done = ?
WHERE id = ?;

updateExported:
UPDATE chapter
SET exported = ?
WHERE id = ?;

invalidateExportIfExported:
UPDATE chapter
SET exported = 0
WHERE id = ? AND exported = 1;

chapterCount:
SELECT count(*) FROM chapter;
